	(text "UPPER BOARD = flight controller.  STM32F765VIT6 running ArduPilot (board name StackF765)."
		(exclude_from_sim no)
		(at 20 102 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "7084d06c-2e54-56ba-96a7-9d29b81cf357")
	)
	(text "Power: +5V arrives from the lower board; VBUS arrives from the USB service board.  An ideal-diode OR"
		(exclude_from_sim no)
		(at 20 106.2 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "173678e4-40b5-50dd-8753-db462fbe151b")
	)
	(text "makes +5V_SYS (silk '4V5'), which feeds the 3.3 V regulators and the OSD, so the board runs from USB alone."
		(exclude_from_sim no)
		(at 20 110.4 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "dde838f7-d3f2-568c-b44f-7b2eca8cab14")
	)
	(text "Header pins marked 5V are powered only from the battery; pins marked 4V5 are also powered from USB."
		(exclude_from_sim no)
		(at 20 114.6 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "15bc240f-ffe5-54e6-963d-d30e67f01baf")
	)
