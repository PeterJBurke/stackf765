	(text "LOWER BOARD = power.  Battery and ESC wires solder to four pads at the rear edge."
		(exclude_from_sim no)
		(at 20 70 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "3c59595f-492a-5381-871e-1a66e6a30eb8")
	)
	(text "Battery + -> 0.5 mohm shunt -> ESC +  (all current, including the flight controller's own, is measured)."
		(exclude_from_sim no)
		(at 20 74.2 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "6f1e53b0-335f-5200-97ce-affae8190f69")
	)
	(text "Two identical 5 V / 3 A regulators: +5V feeds the flight controller, +5V_PI feeds a companion computer."
		(exclude_from_sim no)
		(at 20 78.4 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "a6214367-ddff-5d60-b804-6ed75df55311")
	)
	(text "Both rails go up to the upper board through J1; the motor, LED and companion-power pins are on the upper board."
		(exclude_from_sim no)
		(at 20 82.6 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "8b98239f-108d-5928-b474-bc5ec77b463f")
	)
	(text "Input range 6-13 V (2S-3S LiPo); D1 clamps spikes below 25 V so every part stays inside its ratings.  No reverse-polarity protection: check wiring before connecting a battery."
		(exclude_from_sim no)
		(at 20 86.8 0)
		(effects (font (size 1.8 1.8)) (justify left bottom))
		(uuid "af362675-619f-585f-8e3f-540a3d0c1f0b")
	)
	(text "All components are on the top side; the bottom side carries copper only."
