# StackF765 - two-board STM32F765VIT6 flight controller (github.com/PeterJBurke)
# Hardware definition for ArduPilot (ChibiOS HAL).
# Every pin below is cross-checked against the KiCad netlist by tools/check_hwdef.py.

MCU STM32F7xx STM32F767xx
# Private board ID (outside the 1000-19999 range managed by ArduPilot).
# Request an official ID before distributing firmware; see docs/firmware.md.
APJ_BOARD_ID 20765

OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 96

STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# ---------------------------------------------------------------- USB / debug
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# ---------------------------------------------------------------- serial ports
# SERIAL0=USB, SERIAL1..7 = header labels UART1,2,3,4,6,7,8
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 USART6 UART7 UART8

PA9  USART1_TX USART1
PA10 USART1_RX USART1
PD5  USART2_TX USART2 NODMA
PD6  USART2_RX USART2 NODMA
PD8  USART3_TX USART3 NODMA
PD9  USART3_RX USART3 NODMA
PD1  UART4_TX UART4 NODMA
PD0  UART4_RX UART4 NODMA
PC6  USART6_TX USART6 NODMA
PC7  USART6_RX USART6 NODMA
PE8  UART7_TX UART7
PE7  UART7_RX UART7
PE1  UART8_TX UART8 NODMA
PE0  UART8_RX UART8 NODMA

# ---------------------------------------------------------------- SPI
# SPI1: ICM-42688-P IMU
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PC4 IMU1_CS CS
PC5 IMU1_INT INPUT

# SPI2: AT7456E analog OSD
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2
PB12 MAX7456_CS CS

SPIDEV icm42688 SPI1 DEVID1 IMU1_CS    MODE3  2*MHZ 16*MHZ
SPIDEV osd      SPI2 DEVID4 MAX7456_CS MODE0 10*MHZ 10*MHZ

# ---------------------------------------------------------------- I2C
# I2C2 = on-board barometer (internal), I2C1 = SDA/SCL header pins (external compass etc.)
I2C_ORDER I2C2 I2C1
PB6  I2C1_SCL I2C1
PB7  I2C1_SDA I2C1
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2
define HAL_I2C_INTERNAL_MASK 1

# ---------------------------------------------------------------- sensors
# IMU orientation is set from the PCB placement; verify on the bench (docs/bringup.md)
IMU Invensensev3 SPI:icm42688 ROTATION_NONE
define HAL_DEFAULT_INS_FAST_SAMPLE 1
BARO BMP388 I2C:0:0x76

define AP_COMPASS_PROBING_ENABLED 1
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# ---------------------------------------------------------------- analog
PC2 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC3 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 12
define HAL_BATT_CURR_PIN 13
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 20.0

# ---------------------------------------------------------------- LEDs / buzzer
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PD10 LED0 OUTPUT LOW GPIO(90) # blue
PD11 LED1 OUTPUT LOW GPIO(91) # green
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

# passive buzzer on the service board, driven through a high-side switch
PB9 TIM11_CH1 TIM11 GPIO(32) ALARM

# ---------------------------------------------------------------- motor / LED outputs
PA0 TIM2_CH1  TIM2 PWM(1) GPIO(50) BIDIR
PA1 TIM2_CH2  TIM2 PWM(2) GPIO(51)
PA2 TIM5_CH3  TIM5 PWM(3) GPIO(52) BIDIR
PA3 TIM5_CH4  TIM5 PWM(4) GPIO(53)
PB0 TIM8_CH2N TIM8 PWM(5) GPIO(54)
PB1 TIM8_CH3N TIM8 PWM(6) GPIO(55)
PA8 TIM1_CH1  TIM1 PWM(7) GPIO(56) # LED strip pin

# ---------------------------------------------------------------- microSD
PC8  SDMMC_D0  SDMMC1
PC9  SDMMC_D1  SDMMC1
PC10 SDMMC_D2  SDMMC1
PC11 SDMMC_D3  SDMMC1
PC12 SDMMC_CK  SDMMC1
PD2  SDMMC_CMD SDMMC1
define HAL_OS_FATFS_IO 1

DMA_PRIORITY S*

# ---------------------------------------------------------------- storage / OSD
define HAL_STORAGE_SIZE 16384
STORAGE_FLASH_PAGE 1

define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin
