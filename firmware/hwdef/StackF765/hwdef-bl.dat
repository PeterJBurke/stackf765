# StackF765 bootloader hardware definition
MCU STM32F7xx STM32F767xx
APJ_BOARD_ID 20765
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 96

SERIAL_ORDER OTG1 USART1
PA9  USART1_TX USART1
PA10 USART1_RX USART1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PD10 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0

# keep SPI devices deselected while in the bootloader
PC4  IMU1_CS CS
PB12 MAX7456_CS CS
